# Raseed environment configuration

# SQLite (local / VPS). On the `demo` branch, Vercel uses Turso instead:
# DATABASE_URL="libsql://YOUR-db.turso.io"
# TURSO_AUTH_TOKEN="…"
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session JWTs. Use a long random string in production.
JWT_SECRET="change-this-to-a-long-random-secret-string"

# App base URL (used by the e2e script; defaults to http://localhost:3000)
APP_URL="http://localhost:3000"
